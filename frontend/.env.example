# VITE_API_URL: Backend API URL.
# For local development: http://localhost:3000
# For production (Render): https://your-backend.onrender.com
VITE_API_URL=http://localhost:3000

# VITE_WS_URL: WebSocket endpoint for live tracking (optional).
# Defaults to VITE_API_URL with /ws/tracking path if not set.
# For local development: ws://localhost:3000/ws/tracking
# For production: wss://your-backend.onrender.com/ws/tracking
VITE_WS_URL=ws://localhost:3000/ws/tracking
