# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this backend is hosted.
# For Render deployment, this will be auto-generated.
# For local development: http://localhost:3000
APP_URL="http://localhost:3000"

# FRONTEND_URL: URL of the separately deployed frontend.
# For Vercel deployment: https://your-frontend.vercel.app
# For local development: http://localhost:5173
FRONTEND_URL="http://localhost:5173"

# Port used by the API server.
PORT=3000

# DATABASE_URL: MongoDB connection string.
# For local development (local MongoDB): mongodb://localhost:27017/genmedi
# For local development (Docker): mongodb://host.docker.internal:27017/genmedi
# For production (MongoDB Atlas): mongodb+srv://username:password@cluster.mongodb.net/genmedi?retryWrites=true&w=majority
# Note: If using local MongoDB, ensure MongoDB is running before starting the backend
DATABASE_URL="mongodb://localhost:27017/genmedi"

# JWT_SECRET: Secret key for signing access tokens (15min expiry).
# MUST be changed in production. Use a strong random string (64+ chars).
# Generate with: openssl rand -base64 64
JWT_SECRET="genmedi-dev-secret-key-2026-change-in-production"

# JWT_REFRESH_SECRET: Secret key for signing refresh tokens (7 day expiry).
# MUST be changed in production. Use a different strong random string.
# Generate with: openssl rand -base64 64
JWT_REFRESH_SECRET="genmedi-dev-refresh-secret-2026-change-in-production"

# RAZORPAY_KEY_ID: Razorpay payment gateway key ID.
# Get from: https://dashboard.razorpay.com/apikeys
RAZORPAY_KEY_ID="your-razorpay-key-id"

# RAZORPAY_KEY_SECRET: Razorpay payment gateway key secret.
# Get from: https://dashboard.razorpay.com/apikeys
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
